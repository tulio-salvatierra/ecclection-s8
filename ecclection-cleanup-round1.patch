-  });
-  
-  // Extract quotes
-  const quotes = extractQuotes(htmlContent);
-  quotes.forEach(quote => {
-    blocks.push({
-      id: `quote-${blockIndex++}`,
-      type: 'quote',
-      content: `<blockquote>${quote}</blockquote>`
