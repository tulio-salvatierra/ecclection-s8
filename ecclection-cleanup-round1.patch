-function extractLists(html: string): Array<{items: string[]; type: 'ul' | 'ol'}> {
-  const listRegex = /<(ul|ol)[^>]*>(.*?)<\/(ul|ol)>/gi;
-  const lists: Array<{items: string[]; type: 'ul' | 'ol'}> = [];
