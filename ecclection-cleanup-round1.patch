-  const blocks: ContentBlock[] = [];
-  let blockIndex = 0;
-  
-  // Extract headings
-  const headings = extractHeadings(htmlContent);
-  headings.forEach(heading => {
-    blocks.push({
-      id: `heading-${blockIndex++}`,
-      type: 'heading',
-      content: heading.content,
-      metadata: {
-        level: heading.level
-      }
-    });
-  });
-  
-  // Extract images
-  const images = extractImages(htmlContent);
-  images.forEach(image => {
-    blocks.push({
-      id: `image-${blockIndex++}`,
